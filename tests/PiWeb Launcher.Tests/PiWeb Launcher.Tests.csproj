<Project Sdk="Microsoft.NET.Sdk">

  <!-- 只测**不依赖界面的纯逻辑**:目录页解析、pi list 解析、URL 推导、版本比较、日志裁剪、
       编码判定、设置 JSON 的宽容枚举解析…… 这些正是注释里写满"实测踩过的坑"的地方,
       也最容易在重构中被静默改坏。
       Nullable / LangVersion / 分析器设置继承仓库根的 Directory.Build.props。

       测试框架用 MSTest 而不是 xunit:当前开发机访问不到 nuget.org,只有随 Visual Studio
       安装的离线包源里有可用的测试包(mstest 3.1.1 + Microsoft.NET.Test.Sdk 17.10);
       等能联网后把 Test.Sdk 换成最新稳定版即可,测试代码本身与框架无关的部分不受影响。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PiWeb_Launcher.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0-preview-24080-01" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PiWeb Launcher\PiWeb Launcher.csproj" />
  </ItemGroup>

  <!-- pi.dev/packages 的**真实页面样本**(2026-09 抓取)。
       目录解析规则必须拿真页面固定住:站点改版时测试会立刻红,而不是等到用户发现列表空了。
       Fixtures 是数据、不是编译输入,所以不从默认的 None 里排除,直接当内容文件即可。 -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
